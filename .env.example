# CIVISENSE Environment Configuration
PROJECT_NAME="CIVISENSE"
API_V1_STR="/api"
PORT=8000
HOST="127.0.0.1"

# Database Configuration (Defaults to SQLite for local development; supports PostgreSQL)
DATABASE_URL="sqlite:///./civisense.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/civisense"

# Geographic Study Area Reference (Chandigarh, India)
CHANDIGARH_LAT=30.7333
CHANDIGARH_LON=76.7794
TIMEZONE="Asia/Kolkata"

# External API Integrations
OPEN_METEO_FORECAST_URL="https://api.open-meteo.com/v1/forecast"
OPEN_METEO_ELEVATION_URL="https://api.open-meteo.com/v1/elevation"
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"

# Cache TTL (seconds)
WEATHER_CACHE_TTL=900
DRAINAGE_CACHE_TTL=86400
TERRAIN_CACHE_TTL=604800
